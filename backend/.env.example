# --- Base de données PostgreSQL (Ville) ---
POSTGRES_HOST=            # voir équipe DSI
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=            # voir équipe DSI
POSTGRES_PASSWORD=        # voir équipe DSI
POSTGRES_SCHEMA=charte_ia

# --- API centrale APM (services transverses) ---
APM_API_URL=https://api.ivry.local
APM_API_KEY=              # clé X-API-KEY fournie par l'admin APM
# Certificat auto-signé en interne : mettre false si nécessaire
APM_TLS_REJECT_UNAUTHORIZED=false

# --- API métier Hub DSI (données Ville + fonctions métier) ---
HUBDSI_API_URL=https://dsihub.ivry.local
HUBDSI_API_KEY=           # clé dsk_... fournie par l'admin Hub DSI (scope: ville)

# --- Application ---
PORT=5310
JWT_SECRET=               # secret de signature des JWT applicatifs
NODE_ENV=production
CORS_ORIGIN=              # origine(s) du frontend, séparées par des virgules
APP_URL=                  # URL publique de l'app (liens des e-mails de digest)

# --- Jobs planifiés (e-mails réels via APM) ---
# Laisser false tant que l'on ne veut pas envoyer de vrais e-mails.
NOTIFICATIONS_ENABLED=false

# --- Développement uniquement ---
# Identifiants de secours (connexion locale si l'AD n'est pas joignable)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
