# Variables utilisées par docker-compose.yml (build du frontend).

# Laisser VIDE (recommandé) : le frontend appelle son origine, et Nginx proxifie
# /api et /uploads vers le service backend. Évite les problèmes de CORS et de
# « localhost » côté navigateur.
APP_API_URL=

# À renseigner uniquement si le frontend doit appeler une API située sur une
# autre origine, ex. : APP_API_URL=https://charte-ia-api.ivry.local
